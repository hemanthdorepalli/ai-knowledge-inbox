# Gemini — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
EMBEDDING_MODEL=gemini-embedding-001
CHAT_MODEL=gemini-2.5-flash
EMBEDDING_DIM=768

# Supabase Postgres connection string.
# Dashboard -> Project Settings -> Database -> Connection string -> URI
# (replace [YOUR-PASSWORD] with your database password).
SUPABASE_DB_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase API — used to verify the user's login token on each request.
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

CORS_ORIGINS=http://localhost:5173

# Fixed lifetime token budget per user (covers ingest + chat).
DEFAULT_TOKEN_QUOTA=50000

# MCP tool calling: max tool-calling round trips per question.
MCP_MAX_TOOL_ROUNDS=4
# Dev-only: allows connecting an MCP server on localhost/private IPs for local
# testing. Must stay false (the default) in any real deployment.
ALLOW_LOCAL_MCP_URLS=false
